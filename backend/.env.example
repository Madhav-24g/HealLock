# ==============================================================================
# HEALLOCK BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

APP_NAME=HealLock
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./heallock.db

# Security & Encryption
SECRET_KEY=heallock-super-secure-jwt-secret-key-32b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=heallock-aes-key-32-bytes-long!!

# Firebase Auth
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# AI APIs
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloud Storage
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Blockchain RPC
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
