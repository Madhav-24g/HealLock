# ==============================================================================
# HEALLOCK PLATFORM — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `backend/.env` and `frontend/.env` to configure your services.
# All services below offer free developer tiers.

# ==============================================================================
# 1. DATABASE CONFIGURATION (RECOMMENDED: Supabase / Neon PostgreSQL)
# ==============================================================================
# - Local SQLite (Default, 0 setup): sqlite:///./heallock.db
# - Free Managed PostgreSQL (Supabase -> https://supabase.com/):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./heallock.db

# ==============================================================================
# 2. SECURITY & ENCRYPTION (AES-256 GCM + JWT)
# ==============================================================================
# - SECRET_KEY: Random 32+ char secret for JWT authentication tokens
# - ENCRYPTION_KEY: Exact 32-character key for encrypting medical records
SECRET_KEY=heallock-super-secure-jwt-secret-key-32b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=heallock-aes-key-32-bytes-long!!

# ==============================================================================
# 3. AI & CLINICAL DECISION SUPPORT APIs (RECOMMENDED: Claude 3.5 Sonnet)
# ==============================================================================
# - Anthropic Claude API (https://console.anthropic.com/):
#   Powers Document AI extraction & clinical drug-drug interaction safety checks.
ANTHROPIC_API_KEY=

# - Google Gemini API (https://aistudio.google.com/):
GOOGLE_GEMINI_API_KEY=

# - OpenAI API (https://platform.openai.com/):
OPENAI_API_KEY=

# ==============================================================================
# 4. FIREBASE AUTHENTICATION (RECOMMENDED FOR CLOUD AUTH)
# ==============================================================================
# - Create free project at: https://console.firebase.google.com/
# - Backend: Project Settings -> Service Accounts -> Generate new private key
# - Frontend: Project Settings -> General -> Your apps (Web </>)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Frontend Vite variables:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==============================================================================
# 5. CLOUD FILE STORAGE (RECOMMENDED: Cloudflare R2 / AWS S3)
# ==============================================================================
# - For storing binary lab report PDFs, DICOM scans, and images
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=heallock-medical-records

# ==============================================================================
# 6. BLOCKCHAIN AUDIT LEDGER (RECOMMENDED: Polygon Amoy / Sepolia Testnet)
# ==============================================================================
# - Free RPC node from Alchemy (https://www.alchemy.com/) or Infura (https://infura.io/)
# - Example: https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

# ==============================================================================
# 7. SMS & EMERGENCY NOTIFICATIONS (Twilio)
# ==============================================================================
# - Free trial available at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
